{
  "name": "graph-modeling-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --config vite.config.ts",
    "server": "node server/server.mjs",
    "backend": "node server/server.mjs",
    "build": "tsc -b && vite build --config vite.config.ts",
    "audit:icons": "node scripts/audit-icon-library-quality.mjs",
    "gen:gbk-table": "node scripts/gen-gbk-table.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vite.e2e.config.ts",
    "preview": "vite preview --host 127.0.0.1 --config vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.5.17",
    "antd": "^6.6.1",
    "iconv-lite": "^0.7.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@xmldom/xmldom": "^0.9.10",
    "fake-indexeddb": "^6.2.5",
    "vitest": "^3.0.0"
  }
